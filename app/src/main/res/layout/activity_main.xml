<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/title_visionex" android:textStyle="bold" android:textSize="28sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/subtitle" android:layout_marginBottom="8dp"/>
<com.google.android.material.tabs.TabLayout android:id="@+id/tabLayout" android:layout_width="match_parent" android:layout_height="wrap_content" app:tabMode="fixed" app:tabGravity="fill"/>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
<FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:id="@+id/homeSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="12dp">
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/device" android:textStyle="bold" android:textSize="18sp"/><TextView android:id="@+id/connectionText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/disconnected"/><Button android:id="@+id/connectButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/scan_for_visionex"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="12dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/current_status" android:textStyle="bold" android:textSize="18sp"/><TextView android:id="@+id/drowsinessText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/normal" android:textStyle="bold" android:textSize="26sp"/><TextView android:id="@+id/batteryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/battery_unknown"/><TextView android:id="@+id/alertCountText" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Button android:id="@+id/ackButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/acknowledge_alert"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<Button android:id="@+id/simulateButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/simulate_drowsiness"/>
</LinearLayout>
<LinearLayout android:id="@+id/historySection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="12dp" android:visibility="gone"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/event_history" android:textStyle="bold" android:textSize="20sp"/><TextView android:id="@+id/historyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="220dp" android:padding="12dp"/><Button android:id="@+id/clearHistoryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clear_history"/></LinearLayout>
<LinearLayout android:id="@+id/settingsSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="12dp" android:visibility="gone">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/alert_preferences" android:textStyle="bold" android:textSize="20sp"/>
<com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/vibrationSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/vibration_enabled"/>
<TextView android:id="@+id/vibrationStrengthText" android:layout_width="wrap_content" android:layout_height="wrap_content"/><SeekBar android:id="@+id/vibrationSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/><Button android:id="@+id/applyVibrationButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/apply_vibration_strength"/>
<com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/buzzerSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/buzzer_enabled"/>
<TextView android:id="@+id/emergencyThresholdText" android:layout_width="wrap_content" android:layout_height="wrap_content"/><SeekBar android:id="@+id/emergencyThresholdSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="4"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/emergency" android:textStyle="bold" android:textSize="20sp" android:layout_marginTop="12dp"/>
<EditText android:id="@+id/contactInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/emergency_contact_hint" android:inputType="phone"/>
<com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/autoSmsSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/automatic_sms"/>
<Button android:id="@+id/testSmsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/send_test_emergency_sms"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/appearance" android:textStyle="bold" android:textSize="20sp" android:layout_marginTop="12dp"/>
<RadioGroup android:id="@+id/themeGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><RadioButton android:id="@+id/themeSystem" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/theme_system"/><RadioButton android:id="@+id/themeLight" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/theme_light"/><RadioButton android:id="@+id/themeDark" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/theme_dark"/></RadioGroup>
</LinearLayout>
</FrameLayout></ScrollView></LinearLayout>