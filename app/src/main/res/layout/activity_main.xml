<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@color/surface">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VISIONEX" android:textStyle="bold" android:textSize="30sp" android:textColor="@color/text_primary"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Driver Drowsiness Monitoring" android:textSize="15sp" android:layout_marginBottom="16dp"/>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" android:layout_marginBottom="12dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Device" android:textStyle="bold" android:textSize="18sp"/><TextView android:id="@+id/connectionText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Disconnected" android:textSize="16sp" android:layout_marginTop="8dp"/><Button android:id="@+id/connectButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Scan for VisionEx" android:layout_marginTop="10dp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" android:layout_marginBottom="12dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Current Status" android:textStyle="bold" android:textSize="18sp"/><TextView android:id="@+id/drowsinessText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NORMAL" android:textStyle="bold" android:textSize="28sp" android:layout_marginTop="8dp"/><TextView android:id="@+id/batteryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Battery: --%" android:textSize="16sp"/><TextView android:id="@+id/alertCountText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unacknowledged alerts: 0" android:textSize="16sp"/><Button android:id="@+id/ackButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Acknowledge Alert" android:layout_marginTop="10dp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" android:layout_marginBottom="12dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Emergency" android:textStyle="bold" android:textSize="18sp"/><EditText android:id="@+id/contactInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Emergency contact number" android:inputType="phone"/><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/autoSmsSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Automatic SMS after 3 unacknowledged alerts"/><Button android:id="@+id/testSmsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Send Test Emergency SMS"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" android:layout_marginBottom="12dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prototype Testing" android:textStyle="bold" android:textSize="18sp"/><Button android:id="@+id/simulateButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Simulate Drowsiness Event"/><Button android:id="@+id/clearHistoryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Clear History"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Event History" android:textStyle="bold" android:textSize="18sp"/><TextView android:id="@+id/historyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="140dp" android:text="No events recorded." android:textSize="14sp" android:padding="12dp" android:background="#FFFFFF" android:layout_marginTop="8dp" android:layout_marginBottom="24dp"/>
</LinearLayout></ScrollView>
